# =============================================================================
# 锐捷 ePortal 自动认证配置模板
# 复制为 eportal.conf 并填写（安装方式下配置文件位于 /etc/eportal/eportal.conf，
# 免 root 时位于 ~/.eportal/eportal.conf）
# 所有配置项均可被同名环境变量覆盖
# =============================================================================

# ---- 必填 ----

# 认证账号（学号）
EP_USER=""

# 认证密码（建议避免使用 & = % 和空格字符，存在编码兼容性风险）
EP_PASS=""

# ePortal 服务器地址（模板预填青海大学，其他学校请自行修改）
EP_SERVER="http://210.27.177.172"

# ---- 可选（以下均有默认值，按需修改）----

# 出口网卡名
#   auto = 按默认路由自动探测（需要 iproute2 的 ip 命令）
#   也可手动指定，如 eth0 / wan / pppoe-wan
WAN_IF="auto"

# 认证服务名（URL 编码，默认『校园联通』，已验证可用）
# 切换其他套餐（如移动/电信）建议运行 --setup 向导，直接输入明文名称自动编码；
# 手动修改需自行做双重 URL 编码
SERVICE_NAME="%25E6%25A0%25A1%25E5%259B%25AD%25E8%2581%2594%25E9%2580%259A"

# 状态目录（qs 缓存 / Cookie / userIndex / 临时文件）
#   auto = 优先 /var/lib/eportal，不可写时降级到 ~/.eportal
STATE_DIR="auto"

# 日志文件
#   auto = $STATE_DIR/eportal.log
LOG_FILE="auto"

# watchdog 检测间隔（秒）
CHECK_INTERVAL="60"
